# ---- Copy to .env and change every value marked CHANGE ME. Never commit .env.

# Database (docker compose creates it with these credentials)
POSTGRES_DB=nsut_attendance
POSTGRES_USER=nsut
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
# Used when running the API outside Docker:
DATABASE_URL=postgres://nsut:CHANGE_ME_long_random_password@localhost:5432/nsut_attendance

# Security
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# true when served over HTTPS (required in production behind TLS)
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=1
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Record client IP + user agent on attendance/audit entries (see SECURITY.md → Privacy)
RECORD_CLIENT_META=true

# App
APP_BASE_URL=http://localhost:4000
APP_PORT=4000
PORT=4000
LOG_LEVEL=info
# Show demo-account hints on the sign-in page (demo/training instances only)
DEMO_MODE=false

# Backups (docker compose --profile backup)
BACKUP_HOST_DIR=/mnt/offsite-backups/nsut-attendance
BACKUP_RETENTION_DAYS=30
